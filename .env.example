# From `npx supabase status` (local) or the Supabase dashboard. Public by design: RLS protects the data.
PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only (never PUBLIC_): a secret key (sb_secret_...), which acts as the service_role and
# bypasses RLS; used to write validated survey answers. Locally: SECRET_KEY from `npx supabase
# status`. Hosted: create one per consumer (Vercel, developer scripts) in the dashboard, under
# Project Settings > API Keys, so each can be revoked on its own.
SUPABASE_SECRET_KEY=

# Printed map (server-only).
# Set to 1 to render the map as a draft (BOZZA mark, unapproved rules shown), to try the path
# before the readings are signed off. Leave unset in production until they are.
MAP_DRAFT=

# Cloudflare Turnstile site key (public by design). Local dev: the invisible always-pass test key.
# The matching secret goes to Supabase (supabase/.env locally, see supabase/.env.example).
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000BB

# Admins (server-only): comma-separated addresses synced into public.admins by
# scripts/seed-admins.ts before each Vercel build. Unset leaves the table as it is.
ADMIN_EMAILS=

# SMTP for the app's own emails (the map sent from /admin), server-only. In production use the
# same SMTP account the hosted Supabase project sends its auth emails with. Locally: Mailpit
# (the local Supabase stack, inbox at http://127.0.0.1:54324), no user or password.
SMTP_HOST=127.0.0.1
SMTP_PORT=54325
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Guadagnare non basta+ <mappa@localhost>"
