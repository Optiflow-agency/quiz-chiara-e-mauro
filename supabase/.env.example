# Read by the Supabase CLI for env(...) values in config.toml. Copy to supabase/.env (git-ignored).
# Local dev: Cloudflare's always-pass Turnstile test secret. It pairs with the test site key
# 1x00000000000000000000BB (PUBLIC_TURNSTILE_SITE_KEY in the app's .env). Never commit a real secret.
SUPABASE_AUTH_CAPTCHA_SECRET=1x0000000000000000000000000000000AA
